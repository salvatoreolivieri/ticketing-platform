# Copy to `.env` for local overrides. The services and Drizzle scripts fall
# back to these exact values when the vars are unset, so `.env` is optional
# as long as you use the default docker-compose Postgres.
#
# Host connections (services run on the host, Postgres in Docker):
CATALOG_DATABASE_URL=postgres://catalog_user:catalog_pw@localhost:5433/catalog_db
INVENTORY_DATABASE_URL=postgres://inventory_user:inventory_pw@localhost:5433/inventory_db
ORDERS_DATABASE_URL=postgres://orders_user:orders_pw@localhost:5433/orders_db

# Seed volume for the orders database (defaults to 50000 in the generator).
# SEED_ORDERS=2000
